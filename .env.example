# Copy to .env and adjust. Every value has an offline default, so .env is optional.

# Storage backend: memory | postgres
RAG_LAB_BACKEND=memory
RAG_LAB_DATABASE_URL=postgresql://rag:rag@localhost:5442/rag_lab

# Embedder: hashing (offline, deterministic) | sentence-transformers (needs the `embeddings` extra)
RAG_LAB_EMBEDDER=hashing
RAG_LAB_EMBEDDING_DIM=384
RAG_LAB_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM: fake (offline, extractive) | openai (any OpenAI-compatible endpoint) | ollama
RAG_LAB_LLM=fake
RAG_LAB_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_LAB_OPENAI_API_KEY=
RAG_LAB_OPENAI_MODEL=gpt-4o-mini
RAG_LAB_OLLAMA_URL=http://localhost:11434
RAG_LAB_OLLAMA_MODEL=llama3.1

# Chunking: recursive | fixed | sentence
RAG_LAB_CHUNKER=recursive
RAG_LAB_CHUNK_SIZE=320
RAG_LAB_CHUNK_OVERLAP=40

RAG_LAB_CORPUS_DIR=corpus
RAG_LAB_TRACE_DIR=traces
RAG_LAB_TOP_K=4
